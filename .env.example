# API ключ OpenAI для модели text-embedding-3-small и генерации ответов бота
OPENAI_API_KEY=sk-your-openai-api-key-here

# Пароль для доступа в панель управления базой знаний (/admin)
ADMIN_PASSWORD=admin2026

# Порт веб-сервера
PORT=3000

# Порог косинусного сходства для отсечения нерелевантных вопросов (по умолчанию 0.30)
RAG_THRESHOLD=0.30

# Модель для генерации ответов чат-бота (по умолчанию gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o-mini

